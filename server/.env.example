# =============================================================================
# NOMI MEDIA OS — environment variables
# Copy this file to ".env" (in the same server/ folder) and fill in the values.
# NEVER commit the real .env file — it holds secrets. (.gitignore already
# excludes it.)
# =============================================================================

# Port the server listens on (most hosts set this automatically).
PORT=3000

# How long (seconds) to cache API results before refreshing. 300 = 5 minutes.
CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# NOTION
# -----------------------------------------------------------------------------
# 1. Go to https://www.notion.so/my-integrations → New integration (internal).
# 2. Copy the "Internal Integration Secret" here.
# 3. In Notion, open each page/database you want the OS to read →
#    ••• menu → Connections → connect your integration.
NOTION_TOKEN=

# OPTIONAL: to drive the Clients module live from a Notion database, paste the
# database ID here (the 32-char id in the database URL). Leave blank to use the
# curated client list in server/config/content.js.
NOTION_CLIENTS_DB_ID=

# -----------------------------------------------------------------------------
# GOOGLE (Calendar + Drive) — via a service account
# -----------------------------------------------------------------------------
# 1. In Google Cloud Console, create a project → enable "Google Calendar API"
#    and "Google Drive API".
# 2. Create a Service Account → create a JSON key → download it.
# 3. Paste the ENTIRE JSON key below on ONE line (or a base64 of it).
#    Tip: keep the surrounding single quotes.
# 4. SHARE your Google Calendar with the service account's email
#    (calendar settings → "Share with specific people" → Viewer).
# 5. SHARE the Drive folders/files you want shown with the same email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The calendar to read meetings from — usually your Google account email.
GOOGLE_CALENDAR_ID=admin@nomimediamy.com

# OPTIONAL: limit the Files module to one Drive folder (paste the folder ID from
# its URL). Leave blank to show your most recently modified files.
GOOGLE_DRIVE_FOLDER_ID=
